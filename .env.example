# Copy to .env and fill in. .env is gitignored; this file is versioned.

# --- API credentials ---
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# --- Frozen decisions (see CLAUDE.md "Frozen decisions") ---
# Changing any of these invalidates every number produced before the change.
ANSWERING_MODEL=claude-sonnet-5
JUDGE_MODEL=claude-opus-5
EMBEDDING_MODEL=text-embedding-3-small

# --- Postgres (Arms A-D share ONE instance, ONE database, ONE schema) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=memeval
POSTGRES_USER=memeval
POSTGRES_PASSWORD=memeval

# --- Neo4j: Arm D (added at step 5) ---
# NEO4J_ARMD_URI=bolt://localhost:7687
# NEO4J_ARMD_USER=neo4j
# NEO4J_ARMD_PASSWORD=

# --- Neo4j: Graphiti, separate container (added at step 6) ---
# NEO4J_GRAPHITI_URI=bolt://localhost:7688
# NEO4J_GRAPHITI_USER=neo4j
# NEO4J_GRAPHITI_PASSWORD=
