# Copy to .env and fill in. .env is gitignored; this file is versioned.

# --- API credentials ---
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# --- Frozen. Changing any of these invalidates every earlier number. ---
ANSWERING_MODEL=claude-sonnet-5
JUDGE_MODEL=claude-opus-5
EMBEDDING_MODEL=text-embedding-3-small

# --- Postgres (Arms A-D share ONE instance, ONE database, ONE schema) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=memeval
POSTGRES_USER=memeval
POSTGRES_PASSWORD=memeval

# --- Neo4j: Arm D ---
# Per-container credentials: a second graph container, if one is ever added,
# gets its own variables rather than sharing these.
NEO4J_ARMD_URI=bolt://localhost:7687
NEO4J_ARMD_USER=neo4j
NEO4J_ARMD_PASSWORD=memevalgraph
